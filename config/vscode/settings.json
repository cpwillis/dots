{
  // Editor
  "editor.accessibilitySupport": "off",
  "editor.fontFamily": "'Cascadia Code', Monaco",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "editor.formatOnSave": true,
  "editor.linkedEditing": true,
  "editor.minimap.enabled": false,
  "editor.renderControlCharacters": true,
  "editor.renderWhitespace": "all",
  "editor.rulers": [120], // Vertical Line
  "editor.suggestSelection": "first",

  // Language-Specific Formatters
  "[django-html]": {
    "editor.defaultFormatter": "monosans.djlint",
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "[jinja]": {
    "editor.defaultFormatter": "monosans.djlint",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
  },
  "[sh]": {
    "editor.formatOnSave": false,
  },
  "[sql]": {
    "editor.formatOnSave": false,
  },

  // Window
  "window.commandCenter": false,
  "window.title": "[${rootNameShort}] ${activeEditorMedium}",
  "workbench.activityBar.compact": true,
  "workbench.browser.showInTitleBar": false,
  "workbench.colorTheme": "Dark Modern",
  "workbench.editor.empty.hint": "hidden",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.layoutControl.enabled": false,
  "workbench.productIconTheme": "material-product-icons",
  "workbench.startupEditor": "none",

  // Terminal
  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontFamily": "MesloLGS NF", // Nerd Font glyphs
  "terminal.integrated.initialHint": false,

  // Git
  "git.autofetch": true,
  "git.branchProtection": ["main"], // DON'T PUSH TO MAIN
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.ignoreRebaseWarning": true,
  "git.openRepositoryInParentFolders": "never",

  // GitLens
  "gitlens.advanced.messages": {
    "suppressGitMissingWarning": true,
  },
  "gitlens.views.repositories.files.layout": "tree",
  "gitlens.views.repositories.showContributors": false,
  "gitlens.views.repositories.showTags": false,
  "gitlens.views.repositories.showWorktrees": false,
  "gitlens.views.scm.grouped.views": {
    "branches": true,
    "commits": true,
    "contributors": true,
    "launchpad": false,
    "remotes": true,
    "repositories": true,
    "searchAndCompare": false,
    "stashes": true,
    "tags": true,
    "worktrees": true,
  },

  // GitHub
  "githubIssues.createIssueTriggers": [],
  "githubPullRequests.assignCreated": "${user}",
  "githubPullRequests.createOnPublishBranch": "never",
  "githubPullRequests.pullBranch": "never",
  "githubPullRequests.queries": [
    {
      "label": "Local Pull Request Branches",
      "query": "default",
    },
    {
      "label": "Waiting For My Review",
      "query": "repo:${owner}/${repository} is:open review-requested:${user}",
    },
    {
      "label": "Involves Me",
      "query": "repo:${owner}/${repository} is:open involves:${user}",
    },
    {
      "label": "Created By Me",
      "query": "repo:${owner}/${repository} is:open author:${user}",
    },
    {
      "label": "All Open",
      "query": "default",
    },
  ],

  // Python
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "warning",
  },
  "ruff.lineLength": 120,

  // Todo Highlight
  "todohighlight.keywords": [
    {
      "text": "TODO",
      "color": "#ecf0f1",
      "border": "1px solid #f39c12",
      "borderRadius": "4px",
      "backgroundColor": "#f1c40f",
    },
    {
      "text": "FIXME",
      "color": "#ecf0f1",
      "border": "1px solid #8e44ad",
      "borderRadius": "4px",
      "backgroundColor": "#9b59b6",
    },
    {
      "text": "BUG",
      "color": "#ecf0f1",
      "border": "1px solid #c0392b",
      "borderRadius": "4px",
      "backgroundColor": "#e74c3c",
    },
    {
      "text": "NOTE",
      "color": "#ecf0f1",
      "border": "1px solid #2980b9",
      "borderRadius": "4px",
      "backgroundColor": "#3498db",
    },
    {
      "text": "MISC",
      "color": "#ecf0f1",
      "border": "1px solid #27ae60",
      "borderRadius": "4px",
      "backgroundColor": "#2ecc71",
    },
  ],

  // Chat
  "chat.extensionUnification.enabled": false,
  "chat.tips.enabled": false,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "chat.unifiedAgentsBar.enabled": true,
  "chat.viewSessions.orientation": "stacked",

  // Miscellaneous
  "claudeCode.hideOnboarding": true,
  "claudeCode.preferredLocation": "sidebar",
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderSideBySide": false,
  "emmet.showAbbreviationSuggestions": false,
  "errorLens.messageEnabled": false,
  "explorer.confirmDragAndDrop": false,
  "extensions.ignoreRecommendations": true,
  "files.associations": {
    "www": "javascript",
  },
  "liveServer.settings.donotShowInfoMsg": true,
  "outline.collapseItems": "alwaysCollapse",
  "redhat.telemetry.enabled": false,
  "settingsSync.ignoredSettings": ["-python.interpreter.infoVisibility"],
  "update.showReleaseNotes": false,
}
