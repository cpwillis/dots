{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git --no-pager log --oneline -3)",
      "Bash(git --no-pager log --oneline -4)",
      "Bash(ruff check *)"
    ],
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "agents-sdk": "off",
    "cloudflare": "off",
    "cloudflare-email-service": "off",
    "durable-objects": "off",
    "sandbox-sdk": "off",
    "turnstile-spin": "off",
    "web-perf": "off",
    "workers-best-practices": "off",
    "wrangler": "off",
    "ui-ux-pro-max": "off",
    "design": "off",
    "banner-design": "off",
    "ui-styling": "off",
    "design-system": "off",
    "brand": "off",
    "slides": "off"
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "cloudflare@cloudflare": true,
    "obsidian@obsidian-skills": true,
    "superpowers@superpowers-marketplace": true,
    "ta@touramigo": true,
    "autoresearch@autoresearch": true,
    "paddle@claude-community": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "autoresearch": {
      "source": {
        "source": "github",
        "repo": "uditgoenka/autoresearch"
      }
    },
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "normal",
  "agentPushNotifEnabled": true
